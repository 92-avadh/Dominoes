<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
    editor-extension-mode="False">
    <ui:Style src="../Styles/HomeScreen.uss" />

    <!-- Pure Flexbox Game Root (Safe-Area Aware, Commercial Mobile Presentation) -->
    <ui:VisualElement name="home-root" class="home-root">
        <ui:VisualElement name="safe-content" class="safe-content">
            
            <!-- 1. TOP HUD (Clean Header without duplicate Gear) -->
            <ui:VisualElement name="top-bar" class="top-bar">
                
                <!-- Left: Circular Menu Button (Opens Settings & Audio Options) -->
                <ui:Button name="hamburger-button" class="hud-circle-btn" tooltip="Open Settings &amp; Options">
                    <ui:VisualElement class="hamburger-bar" />
                    <ui:VisualElement class="hamburger-bar" />
                    <ui:VisualElement class="hamburger-bar" />
                </ui:Button>

                <!-- Center: Player Profile Capsule (Tappable Avatar & Level) -->
                <ui:Button name="profile-button" class="hud-profile-capsule" tooltip="View Profile &amp; Stats">
                    <ui:VisualElement class="hud-avatar-frame">
                        <ui:VisualElement class="hud-avatar-img" />
                        <ui:VisualElement class="hud-level-star">
                            <ui:Label name="profile-level-text" class="hud-level-number" text="5" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="hud-profile-info">
                        <ui:Label name="profile-name-label" class="hud-player-name" text="Player 1" />
                        <!-- Subtle XP Progress Track -->
                        <ui:VisualElement class="hud-xp-track">
                            <ui:VisualElement class="hud-xp-fill" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:Button>

                <!-- Right: Balance Spacer for symmetrical centering -->
                <ui:VisualElement class="hud-balance-spacer" />
            </ui:VisualElement>

            <!-- 2. MAIN GAME WORLD LOBBY SECTION -->
            <ui:VisualElement name="main-lobby-area" class="main-lobby-area">
                
                <!-- BRANDING: Polished Game Logo -->
                <ui:VisualElement class="brand-section">
                    <ui:VisualElement class="brand-logo-crest">
                        <ui:Label class="brand-logo-text" text="DOMINOES" />
                    </ui:VisualElement>
                    <ui:VisualElement class="brand-ribbon">
                        <ui:Label class="brand-ribbon-text" text="CHOOSE HOW TO PLAY" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 3 HERO GAME MODE BUTTONS (Rich Physical Game Buttons) -->
                <ui:VisualElement class="mode-buttons-group">
                    
                    <!-- MODE 1: ONLINE (Glossy Royal Blue Game Button) -->
                    <ui:Button name="mode-online-btn" class="game-mode-btn game-mode-btn--online" tooltip="Play Online Multiplayer">
                        <!-- Top Gloss Specular Highlight Layer -->
                        <ui:VisualElement class="btn-top-specular" />
                        
                        <!-- Left Icon Circular Badge -->
                        <ui:VisualElement class="mode-icon-badge mode-icon-badge--online">
                            <ui:VisualElement class="mode-icon-glyph mode-icon-glyph--online" />
                        </ui:VisualElement>

                        <!-- Center Title & Subtitle -->
                        <ui:VisualElement class="mode-text-column">
                            <ui:Label class="mode-title-text" text="ONLINE" />
                            <ui:Label class="mode-subtitle-text" text="Play with real players" />
                        </ui:VisualElement>

                        <!-- Right PLAY Action Pill -->
                        <ui:VisualElement class="mode-play-pill mode-play-pill--online">
                            <ui:Label class="mode-play-text" text="PLAY" />
                        </ui:VisualElement>
                    </ui:Button>

                    <!-- MODE 2: VS COMPUTER (Glossy Vibrant Emerald Green Game Button) -->
                    <ui:Button name="mode-computer-btn" class="game-mode-btn game-mode-btn--computer" tooltip="Play against AI">
                        <!-- Top Gloss Specular Highlight Layer -->
                        <ui:VisualElement class="btn-top-specular" />

                        <!-- Left Icon Circular Badge -->
                        <ui:VisualElement class="mode-icon-badge mode-icon-badge--computer">
                            <ui:VisualElement class="mode-icon-glyph mode-icon-glyph--computer" />
                        </ui:VisualElement>

                        <!-- Center Title & Subtitle -->
                        <ui:VisualElement class="mode-text-column">
                            <ui:Label class="mode-title-text" text="VS COMPUTER" />
                            <ui:Label class="mode-subtitle-text" text="Play against AI" />
                        </ui:VisualElement>

                        <!-- Right PLAY Action Pill -->
                        <ui:VisualElement class="mode-play-pill mode-play-pill--computer">
                            <ui:Label class="mode-play-text" text="PLAY" />
                        </ui:VisualElement>
                    </ui:Button>

                    <!-- MODE 3: WITH FRIENDS (Glossy Vibrant Purple/Magenta Game Button) -->
                    <ui:Button name="mode-friends-btn" class="game-mode-btn game-mode-btn--friends" tooltip="Play with Friends">
                        <!-- Top Gloss Specular Highlight Layer -->
                        <ui:VisualElement class="btn-top-specular" />

                        <!-- Left Icon Circular Badge -->
                        <ui:VisualElement class="mode-icon-badge mode-icon-badge--friends">
                            <ui:VisualElement class="mode-icon-glyph mode-icon-glyph--friends" />
                        </ui:VisualElement>

                        <!-- Center Title & Subtitle -->
                        <ui:VisualElement class="mode-text-column">
                            <ui:Label class="mode-title-text" text="WITH FRIENDS" />
                            <ui:Label class="mode-subtitle-text" text="Create or join a private game" />
                        </ui:VisualElement>

                        <!-- Right PLAY Action Pill -->
                        <ui:VisualElement class="mode-play-pill mode-play-pill--friends">
                            <ui:Label class="mode-play-text" text="PLAY" />
                        </ui:VisualElement>
                    </ui:Button>

                </ui:VisualElement>

                <!-- OPTIONAL: How to Play / Tutorial Ribbon -->
                <ui:Button name="home-tutorial-btn" class="tutorial-ribbon-btn" tooltip="Learn the Rules">
                    <ui:Label class="tutorial-ribbon-icon" text="📖" />
                    <ui:Label class="tutorial-ribbon-text" text="HOW TO PLAY • TUTORIAL" />
                    <ui:Label class="tutorial-ribbon-arrow" text="→" />
                </ui:Button>

            </ui:VisualElement>

            <!-- Bottom Spacer for Tropical Scenery & Physical Domino Depth -->
            <ui:VisualElement class="scenery-spacer" />

            <!-- 3. PROFILE & STATS MODAL (Opened ONLY by tapping Player Avatar) -->
            <ui:VisualElement name="profile-stats-modal" class="home-modal" style="display: none;">
                <ui:VisualElement class="modal-backdrop" />
                <ui:VisualElement class="modal-card">
                    <ui:Label class="modal-eyebrow" text="• PLAYER CAREER •" />
                    <ui:Label class="modal-title" text="PLAYER PROFILE" />

                    <!-- Profile Header Card -->
                    <ui:VisualElement class="modal-profile-header">
                        <ui:VisualElement class="modal-avatar-lg" />
                        <ui:VisualElement class="modal-profile-info">
                            <ui:Label name="modal-player-name" class="modal-player-name" text="Player 1" />
                            <ui:Label class="modal-rank-tier" text="Classic Dominoes Player" />
                            <ui:Label name="modal-player-level" class="modal-level-tag" text="Level 5 • Master" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Stats Grid -->
                    <ui:VisualElement class="modal-stats-grid">
                        <ui:VisualElement class="modal-stat-box">
                            <ui:Label class="modal-stat-val" text="48" />
                            <ui:Label class="modal-stat-lbl" text="Matches" />
                        </ui:VisualElement>
                        <ui:VisualElement class="modal-stat-box">
                            <ui:Label class="modal-stat-val" text="68%" />
                            <ui:Label class="modal-stat-lbl" text="Win Rate" />
                        </ui:VisualElement>
                        <ui:VisualElement class="modal-stat-box">
                            <ui:Label class="modal-stat-val" text="33" />
                            <ui:Label class="modal-stat-lbl" text="Victories" />
                        </ui:VisualElement>
                        <ui:VisualElement class="modal-stat-box">
                            <ui:Label class="modal-stat-val" text="7" />
                            <ui:Label class="modal-stat-lbl" text="Best Streak" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Button name="profile-close-btn" class="modal-btn-primary" text="CLOSE" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 4. SETTINGS & OPTIONS MODAL (Opened by Menu Button, with Gear Icon in Middle Header) -->
            <ui:VisualElement name="home-settings-modal" class="home-modal" style="display: none;">
                <ui:VisualElement class="modal-backdrop" />
                <ui:VisualElement class="modal-card">
                    <!-- Gear Icon in Middle of Header -->
                    <ui:VisualElement class="modal-gear-badge">
                        <ui:Label class="modal-gear-icon" text="⚙" />
                    </ui:VisualElement>

                    <ui:Label class="modal-eyebrow" text="• PREFERENCES •" />
                    <ui:Label class="modal-title" text="SETTINGS &amp; OPTIONS" />

                    <!-- Music Setting Row -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label class="settings-row-label" text="Background Music" />
                        <ui:Button name="home-settings-music-btn" class="settings-toggle-btn settings-toggle-btn--on">
                            <ui:Label name="home-settings-music-txt" class="settings-toggle-text" text="ON" />
                        </ui:Button>
                    </ui:VisualElement>

                    <!-- Sound Effects Setting Row -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label class="settings-row-label" text="Sound Effects" />
                        <ui:Button name="home-settings-sfx-btn" class="settings-toggle-btn settings-toggle-btn--on">
                            <ui:Label name="home-settings-sfx-txt" class="settings-toggle-text" text="ON" />
                        </ui:Button>
                    </ui:VisualElement>

                    <!-- Haptics Setting Row -->
                    <ui:VisualElement class="settings-row">
                        <ui:Label class="settings-row-label" text="Vibration / Haptics" />
                        <ui:Button name="home-settings-haptics-btn" class="settings-toggle-btn settings-toggle-btn--on">
                            <ui:Label name="home-settings-haptics-txt" class="settings-toggle-text" text="ON" />
                        </ui:Button>
                    </ui:VisualElement>

                    <ui:Button name="home-replay-tutorial-btn" class="modal-btn-secondary" text="Replay Interactive Tutorial" />
                    <ui:Button name="home-settings-close-btn" class="modal-btn-primary" text="SAVE &amp; CLOSE" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
