/* ==========================================================================
   HomeScreen.uss - Unity Dominoes UI Toolkit Stylesheet
   MATCHES SCREENSHOT 2 (Tropical Beach, Gold Coin Pill, 3 Lime 3D Buttons, Action Badges, Profile Footer)
   ========================================================================== */

.home-root {
    width: 100%;
    height: 100%;
    background-image: url('../../images/bg_1.jpg');
    -unity-background-scale-mode: scale-and-crop;
    background-color: #0369A1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.safe-content {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: 16px 14px 12px 14px;
}

/* TOP HUD BAR (Screenshot 2) */
.top-bar {
    width: 100%;
    height: 48px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.hud-coin-capsule {
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: rgba(15, 23, 42, 0.85);
    border-radius: 20px;
    border-width: 2px;
    border-color: #0F172A;
    padding: 2px 4px 2px 2px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);
}

.coin-icon-gold {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: #F59E0B;
    border-width: 2px;
    border-color: #FEF08A;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-right: 6px;
}

.coin-text-val {
    font-size: 16px;
    -unity-font-style: bold;
    color: #FFFFFF;
    margin-right: 8px;
}

.coin-plus-btn {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background-color: #22C55E;
    border-width: 1.5px;
    border-color: #86EFAC;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #FFFFFF;
    font-size: 16px;
    -unity-font-style: bold;
    cursor: pointer;
}

.gear-settings-btn {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background-color: rgba(30, 41, 59, 0.95);
    border-width: 2.5px;
    border-color: #0F172A;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #CBD5E1;
    font-size: 20px;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
    transition-duration: 0.12s;
    transition-property: transform;
}

.gear-settings-btn:active {
    transform: scale(0.92);
}

/* MAIN LOBBY STACKED BUTTONS (Screenshot 2) */
.main-lobby-area {
    width: 100%;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 14px;
}

.mode-buttons-group {
    width: 100%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.game-mode-btn {
    width: 100%;
    height: 72px;
    border-radius: 24px;
    background-color: #D9F99D;
    border-width: 3.5px;
    border-color: #365314;
    border-top-color: #F7FEE7;
    border-bottom-color: #1A2E05;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 0 20px;
    cursor: pointer;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.45);
    transition-duration: 0.12s;
    transition-property: transform;
}

.game-mode-btn:active {
    transform: scale(0.95);
}

.mode-icon-img {
    width: 46px;
    height: 46px;
    margin-right: 14px;
}

.mode-title-text {
    font-size: 20px;
    -unity-font-style: bold;
    color: #1A2E05;
    letter-spacing: 0.5px;
}

/* ACTION BADGES ROW (Missions, Leaderboard, Jackpot) */
.action-badges-row {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: flex-end;
    margin-top: 10px;
    margin-bottom: 6px;
}

.action-badge-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    position: relative;
}

.action-badge-icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: rgba(15, 23, 42, 0.85);
    border-width: 2.5px;
    border-color: #F59E0B;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.5);
    position: relative;
}

.badge-ribbon-tag {
    position: absolute;
    top: -4px;
    background-color: #DC2626;
    border-radius: 6px;
    padding: 1px 6px;
    border-width: 1px;
    border-color: #FEF08A;
}

.badge-ribbon-text {
    font-size: 8px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.action-badge-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: #FFFFFF;
    margin-top: 4px;
}

/* BOTTOM PROFILE FOOTER (Screenshot 2) */
.bottom-profile-bar {
    width: 100%;
    height: 70px;
    background-color: rgba(15, 23, 42, 0.95);
    border-radius: 18px;
    border-width: 2px;
    border-color: #0284C7;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 4px 10px;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.6);
}

.profile-avatar-box {
    position: relative;
    width: 54px;
    height: 54px;
    border-radius: 12px;
    border-width: 2.5px;
    border-color: #0284C7;
    background-color: #38BDF8;
    margin-right: 10px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.flag-badge-topleft {
    position: absolute;
    top: -4px;
    left: -4px;
    width: 16px;
    height: 11px;
    border-radius: 2px;
}

.level-star-bottomcenter {
    position: absolute;
    bottom: -6px;
    left: 17px;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: #A855F7;
    border-width: 1.5px;
    border-color: #FFFFFF;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #FFFFFF;
    font-size: 10px;
    -unity-font-style: bold;
}

.profile-details-column {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
}

.profile-name-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.profile-name-text {
    font-size: 15px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.edit-profile-btn {
    background-color: #0369A1;
    border-radius: 8px;
    border-width: 1.5px;
    border-color: #38BDF8;
    padding: 2px 8px;
    color: #FFFFFF;
    font-size: 9px;
    -unity-font-style: bold;
    cursor: pointer;
}

.xp-bar-track {
    width: 100%;
    height: 12px;
    border-radius: 6px;
    background-color: #0F172A;
    border-width: 1px;
    border-color: #0284C7;
    margin-top: 4px;
    position: relative;
    overflow: hidden;
}

.xp-bar-fill {
    width: 15%;
    height: 100%;
    background-color: #0284C7;
}

.xp-bar-text {
    position: absolute;
    right: 6px;
    top: 0;
    font-size: 8px;
    -unity-font-style: bold;
    color: #FFFFFF;
}
