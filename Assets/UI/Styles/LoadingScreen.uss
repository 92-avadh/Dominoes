/* ==========================================================================
   LoadingScreen.uss - Commercial Loading Screen Stylesheet
   Tropical Resort Atmosphere • Gold Capsule Progress Bar • Master Palette
   ========================================================================== */

.loading-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #064E3B;
    background-image: url('../../images/bg_2.jpg');
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

.loading-safe-content {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    justify-content: space-between;
    align-items: center;
    padding: 32px 24px;
}

.loading-spacer {
    height: 60px;
}

.loading-brand-container {
    align-items: center;
    justify-content: center;
}

.loading-logo-box {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(15, 23, 42, 0.92);
    border-radius: 28px;
    border-width: 2.5px;
    border-color: #F59E0B;
    border-top-color: #FDE047;
    padding: 16px 28px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.6);
}

.loading-logo-tile {
    width: 26px;
    height: 48px;
    border-radius: 6px;
    background-color: #FAF7EE;
    border-width: 1.5px;
    border-color: #CBD5E1;
    border-top-color: #FFFFFF;
    border-bottom-color: #94A3B8;
    align-items: center;
    justify-content: space-between;
    padding: 3px 2px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.4);
}

.loading-logo-tile--left {
    margin-right: 18px;
    rotate: -12deg;
}

.loading-logo-tile--right {
    margin-left: 18px;
    rotate: 12deg;
}

.loading-mini-pip {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: #0F172A;
}

.loading-mini-divider {
    width: 80%;
    height: 1.5px;
    background-color: #94A3B8;
}

.loading-title-column {
    align-items: center;
    justify-content: center;
}

.loading-brand-title {
    font-size: 32px;
    color: #FEF08A;
    -unity-font-style: bold;
    letter-spacing: 4px;
    padding: 0;
    margin: 0;
    text-shadow: 0 4px 10px rgba(0, 0, 0, 0.8);
}

.loading-brand-subtitle {
    font-size: 10px;
    color: #F59E0B;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding: 0;
    margin-top: 2px;
}

.loading-footer {
    width: 100%;
    max-width: 320px;
    align-items: center;
    margin-bottom: 24px;
}

.loading-status-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.loading-status-text {
    font-size: 12.5px;
    color: #FFFFFF;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    padding: 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
}

.loading-percent-text {
    font-size: 12px;
    color: #FEF08A;
    -unity-font-style: bold;
    padding: 0;
}

.loading-progress-track {
    width: 100%;
    height: 12px;
    border-radius: 6px;
    background-color: rgba(15, 23, 42, 0.85);
    border-width: 1.5px;
    border-color: #F59E0B;
    border-top-color: #FDE047;
    overflow: hidden;
    padding: 1.5px;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.5);
}

.loading-progress-fill {
    width: 0%;
    height: 100%;
    border-radius: 4px;
    background-color: #F59E0B;
    border-top-color: #FDE047;
    border-top-width: 1px;
    box-shadow: 0 0 10px rgba(253, 224, 71, 0.8);
    transition-property: width;
    transition-duration: 0.1s;
}

.loading-version-text {
    font-size: 9.5px;
    color: #E2E8F0;
    margin-top: 14px;
    padding: 0;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
}
