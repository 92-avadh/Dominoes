/* ==========================================================================
   LoadingScreen.uss - Responsive Commercial Loading Screen Stylesheet
   Kenney Asset Integration • Mobile-First • Safe Area Aware
   ========================================================================== */

.loading-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #064E3B;
    background-image: url('../Textures/bg_tropical_resort_luxury.png');
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
    /* Safe area handling via CSS variables */
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

.loading-safe-content {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    justify-content: space-between;
    align-items: center;
    padding: 16px 16px;
}

.loading-spacer {
    height: 60px;
}

.loading-brand-container {
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 320px;
    align-self: center;
}

.loading-logo-box {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(15, 23, 42, 0.92);
    border-radius: 32px;
    border-width: 2.5px;
    border-color: #F59E0B;
    border-top-color: #FDE047;
    padding: 16px 16px;
    width: 100%;
    max-width: 300px;
    align-self: center;
    overflow: hidden;
}

.loading-logo-tile {
    width: 32px;
    height: 56px;
    border-radius: 12px;
    background-color: #FAF7EE;
    border-width: 1.5px;
    border-color: #CBD5E1;
    border-top-color: #FFFFFF;
    border-bottom-color: #94A3B8;
    align-items: center;
    justify-content: space-between;
    padding: 4px 2px;
}

.loading-logo-tile--left {
    margin-right: 24px;
    rotate: -12deg;
}

.loading-logo-tile--right {
    margin-left: 24px;
    rotate: 12deg;
}

.loading-mini-pip {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #0F172A;
}

.loading-mini-divider {
    width: 80%;
    height: 2px;
    background-color: #94A3B8;
}

.loading-title-column {
    align-items: center;
    justify-content: center;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.loading-brand-title {
    font-size: 24px;
    color: #FEF08A;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding: 0;
    margin: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.loading-brand-subtitle {
    font-size: 9px;
    color: #F59E0B;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    padding: 0;
    margin-top: 4px;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.loading-footer {
    width: 90%;
    max-width: 280px;
    align-items: center;
    align-self: center;
    margin-bottom: 16px;
}

.loading-status-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    overflow: hidden;
}

.loading-status-text {
    font-size: 11px;
    color: #FFFFFF;
    -unity-font-style: bold;
    letter-spacing: 0.3px;
    padding: 0;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
}

.loading-percent-text {
    font-size: 11px;
    color: #FEF08A;
    -unity-font-style: bold;
    padding: 0;
    flex-shrink: 0;
    margin-left: 6px;
}

.loading-progress-track {
    width: 100%;
    height: 14px;
    border-radius: 9999px;
    background-color: rgba(15, 23, 42, 0.85);
    border-width: 1.5px;
    border-color: #F59E0B;
    border-top-color: #FDE047;
    overflow: hidden;
    padding: 1.5px;
}

.loading-progress-fill {
    width: 0%;
    height: 100%;
    border-radius: 9999px;
    background-color: #F59E0B;
    border-top-color: #FDE047;
    border-top-width: 1px;
    transition-property: width;
    transition-duration: 0.1s;
}

.loading-version-text {
    font-size: 10px;
    color: #E2E8F0;
    margin-top: 24px;
    padding: 0;
}
