/* ==========================================================================
   WaitingScreen.uss - Responsive VS Matchmaking & Commercial Alert Modal
   Kenney Asset Integration • Mobile-First • Safe Area Aware
   ========================================================================== */

/* --------------------------------------------------------------------------
   Root Container (Full Screen Portrait Layout)
   -------------------------------------------------------------------------- */
.waiting-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #0b0f19;
    background-image: url('../Textures/bg_waiting_screen.jpg');
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
    /* Safe area handling */
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.35s;
}

.safe-content {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    justify-content: space-between;
    align-items: center;
    flex-direction: column;
    overflow: hidden;
    padding: 8px 8px;
}

/* -------------------------------------------------------------------------- */
/*   1. TOP HEADER: Metallic Ribbon with Golden 3D "VS" Crest                 */
/* -------------------------------------------------------------------------- */
.vs-header-ribbon {
    width: 100%;
    max-width: 100%;
    height: 44px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(2, 132, 199, 0.94);
    border-radius: 20px;
    border-width: 2px;
    border-color: #F59E0B;
    border-top-color: #FEF08A;
    border-bottom-color: #D97706;
    padding: 4px 12px;
    flex-shrink: 0;
    margin-top: 4px;
}

.vs-mode-badge-left, .vs-mode-badge-right {
    width: 30px;
    height: 30px;
    border-radius: 6px;
    background-color: rgba(3, 105, 161, 0.95);
    border-width: 1.5px;
    border-color: #FEF08A;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.vs-badge-icon {
    width: 20px;
    height: 20px;
    background-image: url('../Textures/icon_domino_badge_gold.png');
    -unity-background-scale-mode: scale-to-fit;
}

.vs-crest-wrap {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.vs-crest-text {
    font-size: 20px;
    color: #FEF08A;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    padding: 0;
    margin-top: -1px;
    margin-bottom: -1px;
}

.vs-mode-title {
    font-size: 9px;
    color: #FFFFFF;
    -unity-font-style: bold;
    letter-spacing: 0.3px;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* --------------------------------------------------------------------------
   2. DYNAMIC VS BATTLE ARENA
   -------------------------------------------------------------------------- */
.vs-arena-container {
    width: 100%;
    max-width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: space-between;
    align-items: center;
    flex-direction: column;
    position: relative;
    padding: 4px 0;
}

/* TOP: Opponents Sector (Crimson Zone) */
.vs-opponents-sector {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 4px 4px;
    flex-shrink: 0;
    min-height: 80px;
}

/* BOTTOM: Human Player Sector (Cyan Zone) */
.vs-human-sector {
    width: 100%;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    padding: 4px 4px;
    flex-shrink: 0;
    min-height: 80px;
}

/* Generic Dynamic Avatar Slot */
.vs-avatar-slot {
    flex-direction: column;
    align-items: center;
    margin: 0 4px;
    flex-shrink: 1;
    min-width: 0;
    transition-property: scale, opacity;
    transition-duration: 0.2s;
}

.vs-avatar-slot--human {
    scale: 1.05;
}

.vs-avatar-ring {
    position: relative;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    border-width: 2.5px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    flex-shrink: 0;
}

.vs-avatar-ring--blue {
    border-color: #38BDF8;
    border-top-color: #7DD3FC;
    background-color: #0369A1;
}

.vs-avatar-ring--red {
    border-color: #FB7185;
    border-top-color: #FDA4AF;
    background-color: #9F1239;
}

.vs-avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 10px;
    -unity-background-scale-mode: scale-and-crop;
}

.vs-avatar-img--you { background-image: url('../Textures/avatar_you.jpg'); }
.vs-avatar-img--opp1 { background-image: url('../Textures/avatar_sophia.jpg'); }
.vs-avatar-img--opp2 { background-image: url('../Textures/avatar_marcus.jpg'); }
.vs-avatar-img--opp3 { background-image: url('../Textures/avatar_elena.jpg'); }

.vs-radar-spinner {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(254, 240, 138, 0.8);
    border-top-color: transparent;
    display: none;
}

.vs-star-level {
    position: absolute;
    bottom: -2px;
    left: -2px;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    background-color: #F59E0B;
    border-width: 1.5px;
    border-color: #FFFFFF;
    justify-content: center;
    align-items: center;
}

.vs-star-num {
    font-size: 10px;
    color: #FFFFFF;
    -unity-font-style: bold;
    padding: 0;
    margin-top: -1px;
}

.vs-name-pill {
    padding: 4px 8px;
    border-radius: 8px;
    border-width: 1.5px;
    margin-top: 4px;
    max-width: 140px;
    min-width: 0;
    flex-shrink: 1;
    overflow: hidden;
    align-items: center;
    justify-content: center;
}

.vs-name-pill--blue {
    background-color: rgba(15, 23, 42, 0.92);
    border-color: #38BDF8;
    max-width: 140px;
}

.vs-name-pill--red {
    background-color: rgba(15, 23, 42, 0.92);
    border-color: #FB7185;
}

.vs-name-text {
    font-size: 10px;
    color: #FFFFFF;
    -unity-font-style: bold;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.vs-status-pill {
    font-size: 10px;
    -unity-font-style: bold;
    padding: 1px 4px;
    border-radius: 3px;
    margin-top: 4px;
    white-space: nowrap;
}

.vs-status-pill--ready {
    background-color: #22C55E;
    color: #0F172A;
}

.vs-status-pill--searching {
    background-color: rgba(225, 29, 72, 0.75);
    color: #FFFFFF;
}

/* CENTER FLOATING MATCH STATUS & COUNTDOWN */
.vs-center-status-card {
    align-self: center;
    background-color: rgba(15, 23, 42, 0.94);
    border-radius: 24px;
    border-width: 2px;
    border-color: #38BDF8;
    border-top-color: #7DD3FC;
    padding: 16px 32px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin: 8px 0;
}

/* Neon Electric Lightning Streak Polish */
.vs-lightning-streak {
    position: absolute;
    width: 220px;
    height: 48px;
    top: -24px;
    background-image: url('../Textures/Particles/particle_lightning_beam.png');
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.95;
}

.vs-sparkle-fx {
    position: absolute;
    width: 28px;
    height: 28px;
    background-image: url('../Textures/Particles/particle_spark_blue.png');
    -unity-background-scale-mode: scale-to-fit;
}

.vs-sparkle-fx--left {
    top: -12px;
    left: -14px;
}

.vs-sparkle-fx--right {
    bottom: -12px;
    right: -14px;
}

.vs-status-eyebrow {
    font-size: 10px;
    color: #F59E0B;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
    padding: 0;
    margin-bottom: 4px;
}

.vs-countdown-hero {
    font-size: 24px;
    color: #FEF08A;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    padding: 0;
    margin-bottom: 4px;
}

.vs-players-ready-text {
    font-size: 10px;
    color: #E2E8F0;
    padding: 0;
}

/* --------------------------------------------------------------------------
   3. FOOTER: Cancel Match Button
   -------------------------------------------------------------------------- */
.waiting-footer {
    width: 100%;
    max-width: 100%;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.vs-cancel-btn {
    width: 100%;
    height: 44px;
    border-radius: 14px;
    background-color: #DC2626;
    border-width: 2px;
    border-color: #FBBF24;
    border-top-color: #FEF08A;
    border-bottom-color: #B91C1C;
    color: #FFFFFF;
    -unity-font-style: bold;
    font-size: 12px;
    letter-spacing: 0.8px;
    justify-content: center;
    align-items: center;
    transition-property: scale, background-color;
    transition-duration: 0.1s;
}

.vs-cancel-btn:active {
    scale: 0.95;
    background-color: #991B1B;
}

/* --------------------------------------------------------------------------
   4. ALERT CONFIRMATION MODAL (Matching Image 3: Broken Domino, Green Felt, Gold Bevels)
   -------------------------------------------------------------------------- */
.alert-dialog-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    /* Account for safe areas */
    padding: 0 0 0 0;
}

.alert-dialog-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(2, 6, 23, 0.88);
}

.alert-felt-card {
    position: relative;
    width: auto;
    max-width: 90%;
    min-width: 260px;
    background-color: #065F46;
    background-image: url('../Textures/bg_emerald_felt.jpg');
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 20px;
    border-width: 2px;
    border-color: #F59E0B;
    border-top-color: #FEF08A;
    border-bottom-color: #D97706;
    padding: 24px 20px 20px 20px;
    align-items: center;
}

/* Close X Button on Top-Right */
.alert-close-x-btn {
    position: absolute;
    top: -12px;
    right: -12px;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background-color: #DC2626;
    border-width: 2px;
    border-color: #F59E0B;
    border-top-color: #FEF08A;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;
    transition-property: scale;
    transition-duration: 0.1s;
}

.alert-close-x-btn:active {
    scale: 0.9;
}

.alert-close-x-icon {
    font-size: 14px;
    color: #FFFFFF;
    -unity-font-style: bold;
    padding: 0;
}

/* Top Gold-Framed Header Tab */
.alert-header-tab {
    position: absolute;
    top: -18px;
    align-self: center;
    background-color: #064E3B;
    border-radius: 12px;
    border-width: 2px;
    border-color: #F59E0B;
    border-top-color: #FEF08A;
    border-bottom-color: #D97706;
    padding: 4px 32px;
}

.alert-header-tab-text {
    font-size: 12px;
    color: #FEF08A;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    padding: 0;
}

/* Center Broken Domino Illustration */
.alert-broken-domino-img {
    width: 120px;
    height: 120px;
    background-image: url('../Textures/icon_broken_domino_luxury.png');
    -unity-background-scale-mode: scale-to-fit;
    margin-top: 8px;
    margin-bottom: 16px;
    border-radius: 8px;
}

/* Confirmation Message Text */
.alert-message-text {
    font-size: 14px;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
    padding: 0 16px;
    white-space: normal;
}

/* Two 3D Game Buttons (Red Exit & Green Play) */
.alert-btn-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.alert-game-btn {
    width: 48%;
    height: 44px;
    border-radius: 14px;
    border-width: 2px;
    border-color: #FBBF24;
    border-top-color: #FEF08A;
    border-bottom-color: #D97706;
    justify-content: center;
    align-items: center;
    color: #FFFFFF;
    -unity-font-style: bold;
    font-size: 14px;
    letter-spacing: 0.8px;
    transition-property: scale;
    transition-duration: 0.1s;
}

.alert-game-btn:active {
    scale: 0.94;
}

.alert-game-btn--exit {
    background-color: #DC2626;
}

.alert-game-btn--play {
    background-color: #16A34A;
}